-- dCalendario: tabela de datas (Modelagem > Nova tabela).
-- Depois de criar: Ferramentas de tabela > Marcar como tabela de datas, coluna Date.
-- Relacionamento: dCalendario[Date] (1) -> fObservacoes[Data] (*)

dCalendario =
VAR Inicio = DATE ( YEAR ( MIN ( fObservacoes[Data] ) ), 1, 1 )
VAR Fim = DATE ( YEAR ( MAX ( fObservacoes[Data] ) ), 12, 31 )
RETURN
    ADDCOLUMNS (
        CALENDAR ( Inicio, Fim ),
        "Ano", YEAR ( [Date] ),
        "MesNumero", MONTH ( [Date] ),
        "Mes", FORMAT ( [Date], "mmm" ),
        "AnoMes", FORMAT ( [Date], "yyyy-mm" ),
        "InicioMes", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
    )

-- Coluna calculada (Ferramentas da tabela > Nova coluna): ano como texto, para eixos de gráfico.
-- AnoTexto = FORMAT ( dCalendario[Date], "yyyy" )

-- Dica: ordene a coluna Mes por MesNumero (Ferramentas de coluna > Classificar por coluna).
