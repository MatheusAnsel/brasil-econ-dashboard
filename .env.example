# PostgreSQL (local via docker compose ou Supabase em produção)
DATABASE_URL=postgres://econ:econ@localhost:5432/econ
# Use true em provedores que exigem SSL (ex.: Supabase)
DATABASE_SSL=false

# API
PORT=3333
# Origens permitidas (separadas por vírgula). Em produção, sem isto nenhuma origem externa é aceita.
CORS_ORIGIN=http://localhost:3000
# Defina como true atrás de proxy (Render, nginx) para o limite de requisições usar o IP real do cliente
# TRUST_PROXY=true
# Cache Redis das rotas pesadas (opcional). Sem isto a API funciona normalmente, só sem cache.
# REDIS_URL=redis://localhost:6379

# Testes: o banco precisa terminar em _test (a suíte apaga os dados dele)
# TEST_DATABASE_URL=postgres://econ:econ@localhost:5432/econ_test
# TEST_REDIS_URL=redis://localhost:6379

# ETL: data inicial da carga histórica (yyyy-mm-dd)
ETL_START_DATE=2000-01-01

# Front (defina no ambiente do Next.js/Vercel; o padrão já é http://localhost:3333)
# NEXT_PUBLIC_API_URL=http://localhost:3333
