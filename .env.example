# PostgreSQL (local via docker compose ou Supabase em produção)
DATABASE_URL=postgres://econ:econ@localhost:5432/econ
# Use true em provedores que exigem SSL (ex.: Supabase)
DATABASE_SSL=false

# API
PORT=3333
CORS_ORIGIN=http://localhost:3000

# ETL: data inicial da carga histórica (yyyy-mm-dd)
ETL_START_DATE=2000-01-01

# Front (defina no ambiente do Next.js/Vercel; o padrão já é http://localhost:3333)
# NEXT_PUBLIC_API_URL=http://localhost:3333
